# SpyderXDR Configuration
# Environment: Production/Development

# Database Configuration
DATABASE_URL=postgresql+asyncpg://xdr_user:xdr_pass@postgres:5432/spyderxdr
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Configuration
REDIS_URL=redis://:xdr_redis_pass@redis:6379
REDIS_TTL=3600

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

# Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert Settings
ALERT_CRITICAL_THRESHOLD=0.95
ALERT_HIGH_THRESHOLD=0.85
ALERT_MEDIUM_THRESHOLD=0.70
ALERT_AUTO_RESPONSE_ENABLED=true

# Detection Engine
DETECTION_BEHAVIORAL_ENABLED=true
DETECTION_ANOMALY_ENABLED=true
DETECTION_SIGNATURE_ENABLED=true
DETECTION_THREAT_INTEL_ENABLED=true
DETECTION_BATCH_SIZE=100

# Threat Intelligence
THREAT_INTEL_UPDATE_INTERVAL=3600
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTXALIENTVAULT_API_KEY=

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ORIGINS=localhost:3000,localhost:8000

# File Upload
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=/tmp/spyderxdr/uploads

# Retention Policies
EVENT_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=180
LOG_RETENTION_DAYS=30

# Performance
MAX_WORKERS=4
REQUEST_TIMEOUT_SECONDS=30
BATCH_PROCESSING_ENABLED=true
